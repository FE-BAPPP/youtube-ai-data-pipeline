# ==============================================================
# YouTube AI Auto Ops - Biến Môi Trường
# Sao chép file này thành .env và điền các giá trị thực tế.
# ==============================================================

# --- YouTube API ---
YOUTUBE_API_KEY=your_api_key_here
VIDEO_ID=fSyw-jZ_f18

# --- AI / LLM API Keys ---
# Danh sách token GitHub Models (phân tách bằng dấu phẩy) dùng cho GPT-4o
GITHUB_TOKENS=token1,token2

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=123456
DB_NAME=youtube_ai_db

# --- Message Queue (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=youtube_comments

# --- Cache (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Webhook Integrations ---
N8N_WEBHOOK_URL=https://your-n8n-url

# --- API Server ---
API_PORT=8080

# --- Whisper API (Google Colab) ---
WHISPER_API_URL=http://your-colab-ngrok-url

# --- Media Processing ---
FRAME_INTERVAL_SEC=5

# ==============================================================
# GHI CHÚ:
# - Nếu chạy Python script BÊN TRONG Docker, đổi localhost thành
#   tên container: yt_rabbitmq, yt_redis, yt_postgres
# - GITHUB_TOKENS hỗ trợ nhiều token (Token Rotation) để tránh
#   bị Rate Limit khi gọi GPT-4o qua GitHub Models.
# ==============================================================
